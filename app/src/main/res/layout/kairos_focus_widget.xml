<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kairos_widget_background"
    android:padding="10dp">

    <!-- No focus: launcher-sized action icons -->
    <LinearLayout
        android:id="@+id/focus_widget_empty_actions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/focus_widget_empty_add"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/widget_btn_add_bg"
            android:contentDescription="@string/widget_add_task"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_add" />

        <ImageView
            android:id="@+id/focus_widget_empty_voice"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="14dp"
            android:contentDescription="@string/widget_voice"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_mic_idle" />
    </LinearLayout>

    <!-- Focus active -->
    <LinearLayout
        android:id="@+id/focus_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/focus_widget_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_focus"
            android:textColor="#9AD7FF"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/focus_widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/focus_widget_done"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/kairos_widget_chip"
                android:contentDescription="@string/widget_done"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_done" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
