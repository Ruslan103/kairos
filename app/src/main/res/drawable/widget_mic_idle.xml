<?xml version="1.0" encoding="utf-8"?>
<!-- Idle mic: indigo→violet (not red; distinct from add blue→purple). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:endColor="#A855F7"
                android:startColor="#4F46E5"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:bottom="14dp"
        android:drawable="@drawable/ic_widget_mic"
        android:left="14dp"
        android:right="14dp"
        android:top="14dp" />
</layer-list>
