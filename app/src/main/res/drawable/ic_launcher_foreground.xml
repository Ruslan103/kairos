    android:viewportHeight="108">

    <!-- Top Base Horizon -->
    <path
        android:pathData="M38,30 L70,30"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="38"
                android:startY="30"
                android:endX="70"
                android:endY="30"
                android:type="linear">
                <item android:offset="0.0" android:color="#9D2CFF" />
                <item android:offset="1.0" android:color="#C13584" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom Base Horizon -->
    <path
        android:pathData="M38,78 L70,78"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="38"
                android:startY="78"
                android:endX="70"
                android:endY="78"
                android:type="linear">
                <item android:offset="0.0" android:color="#E1306C" />
                <item android:offset="1.0" android:color="#FFB020" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Hourglass Body Contour -->
    <path
        android:pathData="M40,32 L68,32 L56,48 C54.5,50 54.5,58 56,60 L68,76 L40,76 L52,60 C53.5,58 53.5,50 52,48 Z"
        android:strokeWidth="3.5"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="40"
                android:startY="30"
                android:endX="68"
                android:endY="78"
                android:type="linear">
                <item android:offset="0.0" android:color="#9D2CFF" />
                <item android:offset="0.32" android:color="#C13584" />
                <item android:offset="0.68" android:color="#E1306C" />
                <item android:offset="1.0" android:color="#FF9E1B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Kanban Columns inside top chamber (horizons) -->
    <!-- Column 1: Left -->
    <path
        android:pathData="M46.5,37.5 L46.5,43.5"
        android:strokeColor="#B3FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />

    <!-- Column 2: Center (taller) -->
    <path
        android:pathData="M54,36 L54,46.5"
        android:strokeColor="#E6FFFFFF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round" />

    <!-- Column 3: Right -->
    <path
        android:pathData="M61.5,37.5 L61.5,42.5"
        android:strokeColor="#B3FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />

    <!-- Kairos Spark / Star of opportunity in bottom chamber -->
    <!-- Soft Glow -->
    <path
        android:pathData="M54,67m-6,0a6,6 0 1,1 12,0a6,6 0 1,1 -12,0"
        android:fillColor="#35FFD166" />

    <!-- 4-point Diamond Star -->
    <path
        android:pathData="M54,61 C54,64.5 51.5,67 48,67 C51.5,67 54,69.5 54,73 C54,69.5 56.5,67 60,67 C56.5,67 54,64.5 54,61 Z"
